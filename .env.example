# Copy to .env.local and set your Yuanbao Search SERVICE API Key locally.
# Do not use Tencent Cloud SecretId/SecretKey here.
YUANBAO_SEARCH_API_KEY=

# Supply your OWN reasoning API key. No credentials are shipped in this repo.
# The public example keeps the project's selected DeepSeek provider and model.
# Fill both API keys before starting an actual investigation.
REASONING_ENABLED=1
REASONING_BASE_URL=https://api.deepseek.com
REASONING_MODEL=deepseek-flash
REASONING_API_KEY=
# Optional: per-call output budget (default 3200); truncation is never retried.
# REASONING_MAX_TOKENS=3200
# Official api.deepseek.com deepseek-flash/v4-pro use none by default so the
# fixed output budget produces JSON. Semantic source/evidence reviews stay on.
# Explicit none/low/high/max override it; generic endpoints have no default.
# REASONING_EFFORT=none

# Required (16+ characters) for non-loopback deployments; use HTTPS externally.
APP_ACCESS_TOKEN=

